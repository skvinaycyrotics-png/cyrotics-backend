# ─────────────────────────────────────────────────────────────────────────────
# CYROTICS BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=https://www.cyrotics.in
# For local dev: FRONTEND_URL=http://localhost:3000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cyrotics?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_A_STRONG_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_STRONG_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Gmail: Enable 2FA → App Passwords → Generate password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tecsupp.cyrotics@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD_HERE
EMAIL_FROM=Cyrotics Technologies <tecsupp.cyrotics@gmail.com>
ADMIN_EMAIL=tecsupp.cyrotics@gmail.com

# ── Admin Seed Credentials (used by scripts/seed.js) ─────────────────────────
ADMIN_NAME=Vinay Kumar Sharma
ADMIN_EMAIL_SEED=admin@cyrotics.in
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_12_CHARS

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=GENERATE_ANOTHER_STRONG_SECRET_HERE

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Render/Railway (set these in your hosting dashboard) ─────────────────────
# All the above vars should also be set as environment variables in Render/Railway
